class Solution {
    public int maxProfit(int[] prices) {
        int profit=0;
          int leftSmall=prices[0];
          for(int i=0;i<prices.length;i++){
            profit=Math.max(profit,prices[i]-leftSmall);
            leftSmall=Math.min(leftSmall,prices[i]);
          }
          return profit;
    }
}
